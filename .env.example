# Local development. `make dev` brings up Postgres + the GCS emulator and
# applies the schema; these values match docker-compose.yml.
DATABASE_URL=postgresql://agentdrive:dev@localhost:5432/agentdrive

# Where artifact bytes live. "gcs" (the default) is the hosted product's
# store and needs GCS_BUCKET (plus GCS_EMULATOR_HOST locally); "fs" is a
# directory on this host and needs STORAGE_FS_ROOT — no emulator, no cloud
# credential, one API process per root.
STORAGE_BACKEND=gcs
GCS_BUCKET=agentdrive-dev
GCS_EMULATOR_HOST=http://localhost:4443
#STORAGE_BACKEND=fs
#STORAGE_FS_ROOT=./var/agentdrive-store
PUBLIC_BASE_URL=http://localhost:8000
CONSOLE_BASE_URL=http://localhost:3000

# Public origin advertised to AGENT runtimes (discovery, OpenAPI servers).
# Empty falls back to PUBLIC_BASE_URL — fine for local dev where both
# surfaces live on the same host.
# Production sets API_BASE_URL=https://drive.tokencanopy.com so RFC 9728
# discovery advertises the canonical resource.
API_BASE_URL=

# Where the credential /v0 accepts comes from.
#   hub    — the Token Canopy Hub (the default; "hub-oidc" is a one-release
#            alias). Its JWKS is fetched from <AUTH_ISSUER>/jwks and every
#            token must carry aud=HUB_PRODUCT_AUDIENCE.
#   local  — a self-hosted install. There is NO issuer: the credential is an
#            opaque API key this installation mints and stores hashed. It
#            needs no origin, no audience and no key file. Run:
#              python -m agentdrive.keys init
#              python -m agentdrive.keys create --subject-type agent --name claude-code
#            which prints `adk_…` once — the same key is the bearer for /v0,
#            the SDKs and the MCP transport. `list` names the keys, `revoke
#            <id>` refuses one from the next request, and a key's scopes are
#            fixed at creation (revoke and reissue to change them).
#            AUTH_ISSUER / AUTH_JWKS_URL / HUB_PRODUCT_AUDIENCE /
#            HUB_MCP_AUDIENCE and the retired AUTH_LOCAL_SIGNING_KEY_FILE are
#            all hub-mode settings and are REFUSED under local rather than
#            ignored, so a value left over from an upgrade cannot look like it
#            still applies. PUBLIC_BASE_URL is not one of them: local mode
#            derives nothing from the origin, but share links are still built
#            on it, so set it to the origin clients really use.
#AUTH_MODE=hub
#AUTH_ISSUER=http://localhost:8080/oidc
#HUB_PRODUCT_AUDIENCE=https://drive.tokencanopy.com

# Isolated content surfaces. Leave every value empty for local development.
# Setting PUBLIC_CONTENT_BASE_URL enables the split renderer and requires the
# trusted SHARE_BASE_URL shell. Roll back to the direct share renderer by
# removing only PUBLIC_CONTENT_BASE_URL; do not point private content public.
# SHARE_BASE_URL=https://share.example.test
# PUBLIC_CONTENT_BASE_URL=https://public.example-usercontent.test
# VIEWER_BASE_URL=https://viewer.example-usercontent.test
SHARE_BASE_URL=
PUBLIC_CONTENT_BASE_URL=
VIEWER_BASE_URL=

# Render a text/html artifact as a document instead of as escaped source
# (2026-08-26 static-HTML rendering design). Author script never runs: the
# markup goes through the allowlist sanitiser, under a CSP that would refuse
# it anyway. Default false everywhere; set true locally to look at it. The
# byte routes still serve text/html as an attachment either way.
STATIC_HTML_RENDERING_ENABLED=false

# Sheet edit sessions are staging-only during beta. False removes all eight
# routes from routing and OpenAPI; set true for local preview testing.
SHEET_SESSIONS_ENABLED=false

# SESSION_SECRET keys the sealed list cursors (core/cursors.py). REQUIRED,
# must be ≥32 chars, must not be the documented default. Generate one with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=REPLACE_ME_RUN_THE_COMMAND_IN_THE_COMMENT_ABOVE

# Legacy alias hosts. Requests whose Host is in LEGACY_HOSTS (comma-separated)
# are answered with a 308 to the same path on LEGACY_REDIRECT_HOST. Both
# empty (the default) installs no redirect; the hosted environment sets them
# for its retiring alias domains only.
#LEGACY_HOSTS=
#LEGACY_REDIRECT_HOST=

# TokenCanopy platform mount (empty = origin root; legacy compatibility only)
#MOUNT_PREFIX=
